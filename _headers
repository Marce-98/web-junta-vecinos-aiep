# Cabeceras HTTP que aplica Cloudflare Pages automáticamente.
# Reducen riesgos básicos de seguridad sin necesidad de servidor propio.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# El panel de la directiva no debe quedar indexado en buscadores.
/admin.html
  X-Robots-Tag: noindex, nofollow
